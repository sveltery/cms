{
  "name": "@sveltery/cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:node": "SVELTERY_ADAPTER=node vite build",
    "start:node": "node build/node/index.js",
    "package:node": "pnpm build:node && node scripts/package-node.mjs",
    "test:node": "node --test tests/node-hosting/*.test.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:production": "node --test tests/production/*.test.ts",
    "test:browser": "playwright test",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/logs SVELTERY_ADAPTER=cloudflare vite build && XDG_CONFIG_HOME=.wrangler/config WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir build/cloudflare/worker",
    "start:cloudflare": "XDG_CONFIG_HOME=.wrangler/config WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --local",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts && node --test tests/cloudflare-hosting/*.test.ts",
    "test:source-ports": "vitest run --config vitest.source-ports.config.ts",
    "test:portable-text": "vitest run --config vitest.portable-text.config.ts",
    "test:portable-text-browser": "vitest run --config vitest.portable-text-browser.config.ts"
  },
  "dependencies": {
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@oslojs/webauthn": "1.0.0",
    "kysely": "0.29.2",
    "ulidx": "2.4.1",
    "valibot": "1.5.0",
    "zod": "4.5.4",
    "@tiptap/core": "3.20.0",
    "@tiptap/pm": "3.20.0",
    "@tiptap/starter-kit": "3.20.0",
    "@tiptap/extension-character-count": "3.20.0",
    "@tiptap/extension-code": "3.20.0",
    "@tiptap/extension-code-block": "3.20.0",
    "@tiptap/extension-list": "3.20.0",
    "@tiptap/extension-focus": "3.20.0",
    "@tiptap/extension-placeholder": "3.20.0",
    "@tiptap/extension-subscript": "3.20.0",
    "@tiptap/extension-superscript": "3.20.0",
    "@tiptap/extension-text-align": "3.20.0",
    "@tiptap/extension-typography": "3.20.0",
    "@tiptap/extension-table": "3.20.0",
    "@tiptap/extension-table-cell": "3.20.0",
    "@tiptap/extension-table-header": "3.20.0",
    "@tiptap/extension-table-row": "3.20.0",
    "@tiptap/extension-link": "3.20.0",
    "@tiptap/suggestion": "3.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260507.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.0",
    "devalue": "5.9.4",
    "miniflare": "4.20260507.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.10",
    "wrangler": "4.99.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "vitest-browser-react": "2.2.0",
    "@tiptap/react": "3.20.0",
    "@testing-library/react": "16.3.0",
    "@lingui/core": "5.9.4",
    "@lingui/react": "5.9.4",
    "@lingui/babel-plugin-lingui-macro": "5.9.4",
    "@babel/core": "7.29.7",
    "@vitejs/plugin-react": "4.6.0",
    "jsdom": "30.1.1"
  }
}
