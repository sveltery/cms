{
  "name": "@sveltery/cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:node": "SVELTERY_ADAPTER=node vite build",
    "start:node": "node build/node/index.js",
    "package:node": "pnpm build:node && node scripts/package-node.mjs",
    "test:node": "node --test tests/node-hosting/*.test.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:production": "node --test tests/production/*.test.ts",
    "test:browser": "playwright test",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/logs SVELTERY_ADAPTER=cloudflare vite build && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir build/cloudflare/worker",
    "start:cloudflare": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --local",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts && node --test tests/cloudflare-hosting/*.test.ts"
  },
  "dependencies": {
    "@oslojs/encoding": "1.1.0",
    "kysely": "0.29.2",
    "ulidx": "2.4.1",
    "valibot": "1.5.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260507.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.0",
    "devalue": "5.9.4",
    "miniflare": "4.20260507.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.10",
    "wrangler": "4.99.0"
  }
}
