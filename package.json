{
  "name": "@sveltery/cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:node": "SVELTERY_ADAPTER=node vite build && node scripts/build-revision-maintenance.mjs node",
    "start:node": "node build/node/index.js",
    "package:node": "pnpm build:node && node scripts/package-node.mjs",
    "test:node": "node --test tests/node-hosting/*.test.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:production": "node --test tests/production/*.test.ts",
    "test:browser": "playwright test",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/logs SVELTERY_ADAPTER=cloudflare vite build && node scripts/build-revision-maintenance.mjs cloudflare && XDG_CONFIG_HOME=.wrangler/config WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir build/cloudflare/worker",
    "start:cloudflare": "XDG_CONFIG_HOME=.wrangler/config WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --local",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts && node --test tests/cloudflare-hosting/*.test.ts",
    "test:source-ports": "node scripts/check-seo-source-ports.mjs && vitest run --config vitest.source-ports.config.ts",
    "test:ui-source": "vitest run --config vitest.ui-source.config.ts",
    "test:media": "vitest run --config vitest.media.config.ts",
    "test:media-picker": "vitest run --config vitest.media-picker.config.ts"
  },
  "dependencies": {
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@oslojs/webauthn": "1.0.0",
    "cn": "0.2.2",
    "kysely": "0.29.2",
    "ulidx": "2.4.1",
    "valibot": "1.5.0",
    "zod": "4.5.4",
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "blurhash": "2.0.5",
    "image-size": "2.0.2",
    "jpeg-js": "0.4.4",
    "mime": "4.1.0",
    "upng-js": "2.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260507.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.0",
    "devalue": "5.9.4",
    "miniflare": "4.20260507.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.10",
    "wrangler": "4.99.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "@types/jsdom": "30.0.0",
    "@tanstack/react-query": "5.90.21",
    "@vitest/browser-playwright": "4.1.10",
    "vitest-browser-react": "2.2.0"
  }
}
