{
  "name": "@sveltery/cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:node": "SVELTERY_ADAPTER=node vite build && node scripts/build-revision-maintenance.mjs node && node scripts/build-doctor.mjs",
    "start:node": "node build/node/index.js",
    "package:node": "pnpm build:node && node scripts/package-node.mjs",
    "test:node": "node --test tests/node-hosting/*.test.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:production": "node --test tests/production/*.test.ts",
    "test:browser": "playwright test",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/logs SVELTERY_ADAPTER=cloudflare vite build && node scripts/build-revision-maintenance.mjs cloudflare && XDG_CONFIG_HOME=.wrangler/config WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir build/cloudflare/worker",
    "start:cloudflare": "XDG_CONFIG_HOME=.wrangler/config WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --local",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts && node --test tests/cloudflare-hosting/*.test.ts",
    "test:source-ports": "node scripts/check-bulk-taxonomy-source.mjs && node scripts/check-seo-source-ports.mjs && vitest run --config vitest.source-ports.config.ts && node scripts/check-redirect-source-ports.mjs && vitest run --config vitest.redirect-source.config.ts && pnpm test:bulk-taxonomy-native && pnpm test:menu-source && pnpm test:menu-native-ui && node scripts/check-redirect-integration-source.mjs && vitest run --config vitest.redirect-integration-source.config.ts && vitest run --config vitest.redirect-ui-native.config.ts && pnpm test:sections-widgets-core && pnpm test:sections-widgets-converter && pnpm test:sections-widgets-transport && pnpm test:sections-widgets-core-d1 && pnpm test:comments-source && pnpm test:comments-native && pnpm test:canonical-installation-source && pnpm test:content-picker-source && pnpm test:content-picker-native-ui && pnpm test:writable-editor-source && pnpm test:writable-editor-ui && node scripts/check-canonical-feature-storage-source.mjs && pnpm test:block-registry-native && pnpm test:block-registry-source && pnpm test:doctor-source && pnpm test:full-search",
    "test:ui-source": "vitest run --config vitest.ui-source.config.ts",
    "test:bulk-taxonomy-native": "vitest run --config vitest.bulk-taxonomy-native.config.ts",
    "test:bulk-taxonomy-source": "node scripts/check-bulk-taxonomy-source.mjs && vitest run --config vitest.bulk-taxonomy.config.ts",
    "test:date-time": "node scripts/check-date-time-source-ports.mjs && TZ=America/New_York vitest run --config vitest.date-time.config.ts",
    "test:date-time:browser": "node scripts/check-date-time-source-ports.mjs && vitest run --config vitest.date-time.browser.config.ts",
    "test:menu-source": "node scripts/check-menu-source.mjs && vitest run --config vitest.menu-source.config.ts",
    "test:menu-native-ui": "vitest run --config vitest.menu-native-ui.config.ts",
    "test:menu-browser-source": "node scripts/check-menu-source.mjs && vitest run --config vitest.menu-browser-source.config.ts",
    "test:redirect-integration-source-browser": "node scripts/check-redirect-integration-source.mjs && vitest run --config vitest.redirect-integration-browser.config.ts",
    "test:sections-widgets-core": "node scripts/check-sections-widgets-source.mjs && vitest run --config vitest.sections-widgets-core.config.ts",
    "test:sections-widgets-browser": "vitest run --config vitest.sections-widgets-browser.config.ts",
    "test:sections-widgets-native": "node --test tests/production/sections-widgets-native.test.ts",
    "test:sections-widgets-converter": "node scripts/check-sections-widgets-converter-source.mjs && vitest run --config vitest.sections-widgets-converter.config.ts",
    "test:sections-widgets-transport": "vitest run --config vitest.sections-widgets-transport.config.ts",
    "test:sections-widgets-core-d1": "node scripts/check-sections-widgets-source.mjs && vitest run --config vitest.sections-widgets-d1.config.ts",
    "test:comments-source": "node scripts/check-comments-source.mjs && vitest run --config vitest.comments-source.config.ts",
    "test:comments-native": "vitest run --config vitest.comments-native.config.ts",
    "test:comments-browser": "node scripts/check-comments-source.mjs && vitest run --config vitest.comments-browser.config.ts",
    "test:canonical-installation-source": "node scripts/check-canonical-installation-source.mjs && vitest run --config vitest.canonical-installation.config.ts",
    "test:content-picker-source": "node scripts/check-content-picker-source.mjs && vitest run --config vitest.content-picker-source.config.ts",
    "test:content-picker-native-ui": "vitest run --config vitest.content-picker-native-ui.config.ts",
    "test:content-picker-browser-source": "node scripts/check-content-picker-source.mjs && vitest run --config vitest.content-picker-browser.config.ts",
    "test:writable-editor-source": "node scripts/check-writable-editor-source.mjs && vitest run --config vitest.writable-editor-source.config.ts",
    "test:writable-editor-ui": "pnpm build && vitest run --config vitest.writable-editor-native.config.ts",
    "test:block-registry-native": "TZ=America/New_York node --test tests/blocks/provider-defaults-original.test.ts tests/blocks/catalogue-fixture.test.ts tests/blocks/provider-preservation.test.ts tests/blocks/comments-readiness-defaults-original.test.ts",
    "test:block-registry-source": "node scripts/check-block-registry-source.mjs && vitest run --config vitest.block-registry-source.config.ts",
    "doctor": "node scripts/doctor.mjs",
    "test:doctor-source": "node scripts/check-doctor-source.mjs && vitest run --config vitest.doctor-source.config.ts",
    "test:full-search": "node scripts/check-search-source.mjs && vitest run --config vitest.full-search.config.ts && vitest run --config vitest.search-review.config.ts"
  },
  "dependencies": {
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@oslojs/webauthn": "1.0.0",
    "cn": "0.2.2",
    "kysely": "0.29.2",
    "ulidx": "2.4.1",
    "valibot": "1.5.0",
    "zod": "4.5.4",
    "date-fns": "4.1.0",
    "@wordpress/block-serialization-default-parser": "5.38.0",
    "parse5": "7.3.0",
    "blurhash": "2.0.5",
    "image-size": "2.0.2",
    "jpeg-js": "0.4.4",
    "mime": "4.1.0",
    "upng-js": "2.1.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260507.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.0",
    "devalue": "5.9.4",
    "miniflare": "4.20260507.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.10",
    "wrangler": "4.99.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "@types/jsdom": "30.0.0",
    "@babel/core": "7.29.7",
    "@lingui/babel-plugin-lingui-macro": "5.9.5",
    "@lingui/conf": "5.9.5",
    "@lingui/core": "5.9.5",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.163.2",
    "@vitest/browser-playwright": "4.1.10",
    "vitest-browser-react": "2.2.0",
    "@testing-library/react": "16.3.2",
    "@cloudflare/kumo": "2.6.0",
    "@lingui/react": "5.9.5"
  }
}
